# 环境变量清单（仅占位值；真实值请写入 .env，.env 已在 .gitignore 中）
#
# 加载方式：`npm start` / `npm run dev` 以 `node --env-file .env` 读入
#   （app/tools/lib/server-env.mjs 的 serverNodeArgs，只有那一处实现）。
#     · 已经是环境变量的值优先 —— `PORT=5199 npm start` 一定压过这里的 PORT。
#     · 只读仓库根目录下的 .env；验收/打包脚本刻意不读它（它们各自注入临时数据目录与端口）。
#     · 行内 `#` 注释可以写，解析时会剥掉。
# 完整说明见《家底快照 技术设计文档》§14 与 §14.1。
# ⚠ 开发/验收/打包的**工具专用变量**（RELEASE_DIR / PKG / OUT_DIR / SHOTS / CHROME_BIN …）
#   写在这里**没用** —— 那些脚本不加载 .env，只在命令行前缀里生效。清单见 §14.1。

# ---- 服务 ----
HOST=127.0.0.1              # 只允许回环地址；绑定其它地址会在启动时直接报错退出
PORT=5188                   # 0 = 每次由系统分配（地址会变，不便收藏）；非 0 = 固定端口
DATA_DIR=                   # 留空 = 仓库内 ./.data（与 npm run dev 同一份数据）
DB_FILE=                    # 留空 = $DATA_DIR/data.sqlite
TOKEN_FILE=                 # 留空 = $DATA_DIR/.token
LOG_LEVEL=info
HTTP_LOG=true               # true = 控制台输出可读日志；false = 纯 JSON 行
AUTO_CREATE_DATA_DIR=true   # 数据目录不存在时自动创建
OPEN_BROWSER=true           # 启动后自动打开浏览器

# ---- 备份（§6.6）----
BACKUP_KEEP=30              # 保留最近多少份「每日备份」。下限取 1 —— 给 0 会让清理早退、等于永不清理
BACKUP_ON_SNAPSHOT=true     # 每次成功保存快照后自动备份；false 则只在「启动后当日首次」备一次

# 原设计的 BACKUP_ENABLED 未实现，也刻意不实现：备份拆成两条独立时机，
# 一个总开关表达不了「只关其中一条」，所以保存后那次由 BACKUP_ON_SNAPSHOT 控制。

# ---- 实时汇率（PRD §3.1.3 / v1.4）----
# 「获取实时汇率」用哪个公开源。取值是**白名单**：frankfurter | er-api | off
#   · frankfurter（默认）—— 欧洲央行参考汇率，含 CNY
#   · er-api              —— open.er-api.com 的开放端点
#   · off                 —— 关掉这个功能；此时点按钮会返回 422 并说明原因
# 请求地址由程序拼接（见 app/server/src/lib/fx-source.ts 的 ENDPOINTS），
# **没有任何由请求参数指定地址的通道** —— 那是 SSRF 入口。非法取值会在启动时直接报错。
FX_SOURCE=frankfurter
# 注意：本项只决定「去哪儿取数」。取数**只在用户点击时发生**，
# 没有定时任务、也不在启动时请求。离线可用性不受影响（失败时汇率表保持原样）。

# ---- 待实现（Step 5 剩余）----
# LOG_RETENTION_DAYS=14     # 日志保留天数与自动清理
# BODY_LIMIT_MB=5           # 请求体上限（当前硬编码 5MB）

# ---- 前端构建 ----
# VITE_API_BASE=/api
